# Copy this file to a private file such as ~/finverse-cloudrun.env.yaml in
# Cloud Shell. Never commit the filled-in copy. YAML values are strings.
NODE_ENV: "production"
STORE: "postgres"
MIGRATE_ON_BOOT: "false"
TRUST_PROXY_HOPS: "1"
CORS_ORIGINS: "https://REPLACE_WITH_CLOUD_RUN_URL"

# Neon direct URLs. DATABASE_URL is the schema owner used only by the job;
# DATABASE_APP_URL uses finverse_app and is used by the running service.
DATABASE_URL: "postgresql://OWNER:OWNER_PASSWORD@DIRECT_HOST/DB?sslmode=require"
DATABASE_APP_URL: "postgresql://finverse_app:APP_PASSWORD@DIRECT_HOST/DB?sslmode=require"

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET: "REPLACE_WITH_RANDOM_SECRET"
MFA_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_BYTE_KEY"
BANK_TOKEN_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_BYTE_KEY"
STATEMENT_IMPORT_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Optional Plaid bank-linking credentials. Leave commented for manual finance. Keep the values in Cloud Run's secret
# manager; do not commit a filled-in copy of this file. Production refuses
# sandbox credentials and requires the webhook URL to be HTTPS.
# PLAID_CLIENT_ID: "REPLACE_WITH_PLAID_PRODUCTION_CLIENT_ID"
# PLAID_SECRET: "REPLACE_WITH_PLAID_PRODUCTION_SECRET"
# PLAID_ENVIRONMENT: "production"
# PLAID_COUNTRIES: "CA,US"
# PLAID_WEBHOOK_URL: "https://REPLACE_WITH_API_HOST/api/bank-webhooks/plaid"
# PLAID_WEB_REDIRECT_URI: "https://REPLACE_WITH_API_HOST/app/"
# Passkeys stay disabled until the same HTTPS host is registered as the WebAuthn
# relying party. Uncomment and replace all values together during deployment.
# WEBAUTHN_ENABLED: "true"
# WEBAUTHN_RP_ID: "REPLACE_WITH_REGISTERED_HOSTNAME"
# WEBAUTHN_ORIGIN: "https://REPLACE_WITH_REGISTERED_HOSTNAME"
# WEBAUTHN_RP_NAME: "FINVERSE"
# Native iOS OAuth is optional until the Universal Link and Apple team are
# registered. Uncomment both values together when shipping the iOS client.
# PLAID_IOS_REDIRECT_URI: "https://REPLACE_WITH_API_HOST/plaid/"
# IOS_TEAM_ID: "REPLACE_WITH_APPLE_TEAM_ID"
HIBP_PASSWORD_CHECK: "required"
SMTP_HOST: "smtp.gmail.com"
SMTP_PORT: "587"
SMTP_SECURE: "false"
SMTP_USER: "REPLACE_WITH_SMTP_USERNAME"
SMTP_PASSWORD: "REPLACE_WITH_SMTP_APP_PASSWORD"
EMAIL_FROM: "FINVERSE <REPLACE_WITH_SMTP_USERNAME>"

# Replace these placeholders with the reviewed, HTTPS legal documents before
# selling. Production intentionally refuses to boot without all four values.
LEGAL_TERMS_VERSION: "technical-beta-v1"
LEGAL_TERMS_URL: "https://REPLACE_WITH_CLOUD_RUN_URL/api/legal/terms/technical-beta-v1"
LEGAL_PRIVACY_VERSION: "technical-beta-v1"
LEGAL_PRIVACY_URL: "https://REPLACE_WITH_CLOUD_RUN_URL/api/legal/privacy/technical-beta-v1"

# Exact git SHA of the image. Required in production so /api/version can
# prove the running process is FINVERSE and not a lookalike HTTP 200.
GIT_SHA: "REPLACE_WITH_GIT_SHA"

# Optional privacy-preserving error sink. Leave unset until a production
# Sentry (or compatible) project exists. FINVERSE still redacts tokens,
# emails, and financial payloads locally even when this is configured.
# SENTRY_DSN: "https://public@o0.ingest.sentry.io/0"
