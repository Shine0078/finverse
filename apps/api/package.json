{
  "name": "@finverse/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "ts-node scripts/with-postgres.ts vitest run",
    "load:smoke": "ts-node scripts/load-smoke.ts",
    "db:start": "ts-node scripts/with-postgres.ts --serve",
    "demo": "ts-node src/seed/demo.ts",
    "migrate": "ts-node src/infra/postgres/migrate.ts",
    "migrate:status": "ts-node scripts/migration-status.ts",
    "migrate:verify": "ts-node scripts/migration-status.ts --require-clean",
    "purge:accounts": "node dist/infra/auth/purge-due-accounts.js",
    "purge:accounts:dev": "ts-node src/infra/auth/purge-due-accounts.ts",
    "plaid:configure": "ts-node scripts/configure-plaid.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "plaid": "^45.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
