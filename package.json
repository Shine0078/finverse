{
  "name": "finverse",
  "version": "0.1.0",
  "private": true,
  "description": "FINVERSE — AI-powered personal finance platform",
  "license": "MIT",
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "6.16.0",
    "multer": "2.3.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @finverse/api",
    "build": "npm run build --workspace @finverse/api",
    "test": "npm run test --workspace @finverse/api",
    "test:db": "npm run test:db --workspace @finverse/api",
    "load:smoke": "npm run load:smoke --workspace @finverse/api",
    "db:start": "npm run db:start --workspace @finverse/api",
    "demo": "npm run demo --workspace @finverse/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  }
}
